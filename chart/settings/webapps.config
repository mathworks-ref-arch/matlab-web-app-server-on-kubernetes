<?xml version="1.0" encoding="utf-8"?>
<settings>
    <!-- please keep alphabetized -->
    <!-- Specify websites from which the web app that is embedded in an iframe HTML element can receive data -->
    <AllowedEventOrigins>{{ .Values.webAppServerSettings.allowedEventOrigins }}</AllowedEventOrigins>
    <!-- Allow HTML content generated by this server to be embedded as an IFRAME on the following sites. See frame-ancestors HTTP header for more info. 
         Should look like "*.acme.com:* dev.local:*" . Empty string means default value, which allows current host only.  -->
    <AllowedFrameAncestors>{{ .Values.webAppServerSettings.allowedFrameAncestors }}</AllowedFrameAncestors>
    <!-- autodeploy folder location, default is <UserStorageRoot>/apps -->
    <AppsPath>/webapps/apps</AppsPath>
    <!-- AppSession.FullScreen - Specify whether web apps start in full screen mode. Set to 1 to turn ON full screen mode. Default is OFF.-->
    <AppSession FullScreen="{{ .Values.webAppServerSettings.appSession.fullScreen }}" 
        ShowFooter="{{ .Values.webAppServerSettings.appSession.showFooter }}"/>
    <!-- Content security policy additions -->
    <ContentSecurityPolicy>
    {{ include "webapps.cspXml" .Values.webAppServerSettings.contentSecurityPolicy }}
    </ContentSecurityPolicy>
    <!-- Cluster.LocalDomain - how this server can be referenced by DNS name -->
    <Cluster Enabled="1" 
             LocalPort="{{ .Values.internal.webappsServerLocalPort }}" 
             LocalDomain="{{ .Values.internal.webappsServiceName }}.{{ .Release.Namespace }}.svc.cluster.local">
    </Cluster>
    <!-- Export server metrics. Default is OFF-->
    <!-- ExportMetrics.Type Specify how to export server metrics. The options are “off | debug | otlp”
                                 off    - turn off exporting metrics.
                                 debug  - export metrics to console
                                 otlp   - export metrics to OTLP collector, specify HTTP endpoint in "ExportMetrics.Destination" -->
    <ExportMetrics Type="{{ .Values.webAppServerSettings.metrics.export.type }}" 
        Destination="{{ .Values.webAppServerSettings.metrics.export.destination }}" />
    
    <!-- Where factory configuration for this product is stored. Default is <WebAppsExePath>../../resources/spfres -->
    <FactoryStorageRoot></FactoryStorageRoot>
    <!-- Number of ms to wait for orderly shutdown function to run -->
    <FevalTimeoutMs>5000</FevalTimeoutMs>
    <!-- Allows having multiple instances with the same version number running on different ports -->
    <InstanceName></InstanceName>
    <!-- License.Source - port@hostname of license manager service, nothing for internal testing -->
    <!-- License.GracePeriod - number of minutes for normal operation with license manager heartbeat lost -->
    <License Source="{{ .Values.global.licenseServer }}" GracePeriod="" StartNoLMInit="{{ .Values.webAppServerSettings.startNoLMInit }}" />
    <!-- Logs.Path - Location for logs, default is <UserStorageRoot>/logs -->
    <!-- Logs.MaxLogSizeMB - Maximum size of individual log, before it will roll over into another file -->
    <!-- Logs.MaxTotalSizeMB - Maximum size of all logs in a directory. Logs over this size will get lost -->
    <!-- Logs.Level - one of verbose, normal, minimal -->
    <Logs Path="/webapps/logs" 
        MaxLogSizeMB="{{ .Values.webAppServerSettings.logRotationSizeMB }}" 
        MaxTotalSizeMB="{{ .Values.webAppServerSettings.logArchiveMaxSizeMB }}" 
        Level="{{ .Values.webAppServerSettings.loggingLevel }}" />
    <!-- Default file size is 100MB -->
    <MaxFileUploadSizeMB>{{ .Values.webAppServerSettings.maxAppUploadSizeMB }}</MaxFileUploadSizeMB>
    <!-- If empty or "auto", 1 per GB of RAM -->
    <MaxWorkers>{{ .Values.webAppServerSettings.maxSessionsPerServer }}</MaxWorkers>
    <!-- Time to wait before new session start failure will be issued -->
    <NewSessionTimeoutSec>{{ .Values.webAppServerSettings.newSessionTimeout }}</NewSessionTimeoutSec>
    <!-- known runtimes that can be used when running older or newer CTFs -->
    <!-- If Runtime.Path is not set, assume runtime is where webapps executable resides <WebAppsExePath> -->
    <!-- If Runtime.MaxPrewarmedWorkers is not set, assume 1/3 of MaxWorkers -->
    <!-- If Runtime.MaxPrewarmedWorkers is not set for multiple runtimes, assume even split of 1/3 of MaxWorkers -->
    <!-- If Runtime.WorkerImage is not set, assume default name for runtime image -->
    <Runtimes>
    {{ include "webapps.runtimesXml" . }}
    </Runtimes>
    <SecPrivateKeyFile>/webapps/config/webapps_private/webapps_key.pem</SecPrivateKeyFile>
    <SecCertFile>/webapps/config/webapps_private/webapps_cert.pem</SecCertFile>
    <!-- The port for the HTTP/HTTPS traffic used by server -->
    <ServerSitePort>{{ .Values.internal.webappsServerMainPort }}</ServerSitePort>
    <!-- session log collector performance tuning -->
    <SessionLogProducer MaxRequestSizeKB="64" PollIntervalSec="10" />
    <!-- Session timeout, in min. If session stops communicating to server after this period it will get terminated -->
    <SessionTimeoutMin>{{ .Values.webAppServerSettings.sessionTimeoutMinutes }}</SessionTimeoutMin>
    <!-- Installation-related settings -->
    <Setup ServerAccount="" 
        ServerAccountCreated="" 
        WorkerAccount="" 
        WorkerAccountGroup="" 
        WorkerAccountCreated="" 
        AuthorsGroup=""/>
    <!-- Set to 1 for plus features which requires license checkout -->
    <UsePlusFeatures>1</UsePlusFeatures>
    <!-- Start in SSL mode. Default is OFF. Set to 1 to turn ON -->
    <UseSSL>1</UseSSL>
    <!-- Sessions to communicate over web sockets protocol (faster). Default is ON.  OFF means more compatibility. Set to 1 to turn ON -->
    <UseWebSockets></UseWebSockets>
    <!-- UserStorageRoot == where user configuration info is stored (platform-specific location of local application data that is writeable to current user) 
    On Windows, it is %LOCALAPPDATA%\MathWorks\webapps\<serverVersion> -->
    <UserStorageRoot>/webapps/usr</UserStorageRoot>
    <!-- Launch Xvfb on Linux with native workers -->
    <UseXvfb></UseXvfb>
    <!-- Master password to protect WebApps server vault -->
    <VaultMasterKey>{{ .Values.webAppServerSettings.vaultPassword }}</VaultMasterKey>
    <!-- VaultStorageRoot == where webapp secrets stored on the server
         default is  <UserStorageRoot>/config/webapps_private -->
    <VaultStorageRoot>{{ .Values.webAppServerSettings.vaultStoragePath }}</VaultStorageRoot>
    <!-- additional parameters to be passed to all worker processes -->
    <WorkerRuntimeOptions></WorkerRuntimeOptions>
    <!-- Set Linux native worker DISPLAY environment variable -->
    <WorkerDisplay></WorkerDisplay>
    <!--- Set Linux native worker/containerized worker startup string -->
    <XvfbStartupString>-screen 0 1280x1024x24 -nolisten tcp -nolisten unix</XvfbStartupString>
</settings>

